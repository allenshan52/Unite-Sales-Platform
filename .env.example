# Docker Compose / PostgreSQL configuration. Copy this file to .env and fill the blank secrets locally.
POSTGRES_DB=unite_map
POSTGRES_USER=unite
POSTGRES_PASSWORD=

# Gateway port exposed on the local machine.
APP_PORT=3100
# Browser origin allowed to log in; set the exact HTTPS origin in production.
CORS_ORIGINS=http://localhost:3100

# First internal administrator. The password is hashed by the API; never commit its raw value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 生产域名入口使用 production；本地 HTTP 开发保持 development。
APP_ENVIRONMENT=development
# Set true only when browsers access the site over HTTPS (for example through a production tunnel/domain).
ADMIN_COOKIE_SECURE=false

# Production database/session safeguards. Defaults suit one API instance; size them against PostgreSQL max_connections.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_SECONDS=900

# Browser-safe AMap JavaScript API key.
AMAP_WEB_KEY=

# Server-side key used by the Nginx AMap JS API security proxy. Never expose this in browser code.
AMAP_SECURITY_JS_CODE=

# Server-side AMap Web Service key used to geocode organization addresses into reliable map pins.
AMAP_REST_API_KEY=

# Shared official-directory import boundary. Keep this low to respect official public sites; adjustable from 1 to 8.
OFFICIAL_IMPORT_MAX_PARALLEL_REQUESTS=4
OFFICIAL_IMPORT_MAX_REQUEST_ATTEMPTS=5
OFFICIAL_IMPORT_REQUEST_TIMEOUT_SECONDS=30
