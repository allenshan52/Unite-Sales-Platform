# Nginx 网关：同源代理 Next.js、FastAPI 与高德安全服务；浏览器永不获得 jscode。
server {
  listen 80;
  server_name _;
  client_max_body_size 20m;

  location /api/ {
    proxy_pass http://api:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # 高德自定义样式服务必须优先匹配，路径与官方 JSAPI 安全代理示例一致。
  location /_AMapService/v4/map/styles {
    set $args "$args&jscode=${AMAP_SECURITY_JS_CODE}";
    proxy_pass https://webapi.amap.com/v4/map/styles;
    proxy_ssl_server_name on;
  }

  # `_AMapService` 是高德固定一级前缀；安全码仅由网关在请求转发时追加。
  location /_AMapService/ {
    set $args "$args&jscode=${AMAP_SECURITY_JS_CODE}";
    proxy_pass https://restapi.amap.com/;
    proxy_set_header Host restapi.amap.com;
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location / {
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
